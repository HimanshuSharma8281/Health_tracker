rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only the authenticated user can read/write their own profile and all subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Challenges: authenticated users can read all, create, update progress, and delete challenges
    match /challenges/{challengeId} {
      allow read, write: if request.auth != null;

      match /{subcollection=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
