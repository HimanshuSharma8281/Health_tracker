# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Firebase Configuration
FIREBASE_PROJECT_ID=healthtracker-e3acf
# Path to service account JSON file, or provide raw JSON/Base64 in FIREBASE_SERVICE_ACCOUNT_JSON
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
DEV_AUTH_BYPASS=true

# Qdrant Vector DB Configuration (Embedded by default, or set URL for remote cluster)
QDRANT_STORAGE_PATH=./data/qdrant_db
QDRANT_URL=

# Server Configuration
HOST=0.0.0.0
PORT=8000
